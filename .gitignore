node_modules/
.next/
out/
build/

# SearXNG 源码与虚拟环境（由 scripts/searxng-setup.sh 生成，不入库）
.searxng/
.searxng-venv/
.searxng.pid
.searxng.log

# 运行时产物：搜索会话、报告、下载的资料
data/

# 登录态 cookie（P14）。**已经被上面那行 data/ 覆盖**，这里再写一遍是刻意的：
# 这是本仓库里唯一一处会写入用户凭证的路径，而「data/ 被拿掉」这种事真会发生
# —— 有人想共享一份报告，顺手把 data/ 从 ignore 里删了，于是他的知乎 cookie
# 跟着下一次 commit 进了 git 历史，再也洗不掉。
# 凭证一旦进过历史就等于泄露，所以这条要有自己的、不依赖任何其它行的防线。
data/auth/

# 环境变量（含 API key）
.env
.env.local
.env*.local

# SearXNG 实例配置：含 server.secret_key，且密钥一旦进 git 历史就洗不掉。
# 仓库里只保留 settings.yml.example 模板。
searxng/settings.yml

# RSS 订阅表：用户自己的订阅，不该跟着仓库走。
# 仓库里只保留 feeds.example.json 模板；代码里另有一份内置默认。
config/feeds.json

.DS_Store
*.tsbuildinfo

# 下载中断残留
*.part

# yt-dlp 单文件二进制（37MB，放本地即可；用 pnpm ytdlp:fetch 拉取）
bin/yt-dlp
bin/yt-dlp_*

# 离线测试装置与临时构建产物
.graphcheck/
