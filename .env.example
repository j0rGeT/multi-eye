# 复制为 .env.local 后按需填写。全部可留空 —— 缺失时会自动降级，不会崩溃。

# --- 搜索层 ---

# SearXNG 实例地址（默认值；自建用 pnpm searxng:setup / searxng:up）
SEARXNG_URL=http://localhost:8888

# 商业搜索 API（可选）。填了则优先于 SearXNG，失败时自动降级回去。
# 申请：https://serper.dev
SERPER_API_KEY=

# yt-dlp 可执行文件路径（可选）。用于 YouTube 搜索与字幕抓取。
# 未安装时 YouTube 会退化为「仅搜索引擎摘要」。
# 安装：uv tool install yt-dlp（brew 版依赖 deno、需要完整 Xcode，本机验证装不上）
YTDLP_PATH=yt-dlp

# --- 图构建层 ---

# Anthropic API Key（可选）。填了则用 Claude 做语义级实体关系抽取与综述，
# 留空则走本地启发式路径（分词 + TF-IDF + 共现 + Louvain），功能不受影响。
ANTHROPIC_API_KEY=

# --- 抓取层 ---

# 抓取/下载走的代理。置空则直连。
# 注意 Node 的全局 fetch 不读 HTTP_PROXY/HTTPS_PROXY，必须在这里显式配置。
# 代价：走代理=用境外 IP 访问国内站点，知乎/B站 可能反而降级 —— 若发现
# 国内站点抓不到，把这一项留空即可回到直连。
FETCH_PROXY_URL=http://127.0.0.1:6666

# 是否启用 Playwright 无头浏览器降级（需先 npx playwright install chromium）
ENABLE_PLAYWRIGHT=false

# 并发与超时
FETCH_TIMEOUT_MS=15000
FETCH_MAX_BYTES=5242880
DOWNLOAD_CONCURRENCY=3
