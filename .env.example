# 复制为 .env.local 后按需填写。全部可留空 —— 缺失时会自动降级，不会崩溃。

# --- 搜索层 ---

# SearXNG 实例地址（默认值；自建用 pnpm searxng:setup / searxng:up）
SEARXNG_URL=http://localhost:8888

# 商业搜索 API（可选）。填了则优先于 SearXNG，失败时自动降级回去。
# 申请：https://serper.dev
SERPER_API_KEY=

# yt-dlp 可执行文件路径（可选）。用于 YouTube 搜索与字幕抓取。
# 未安装时 YouTube 会退化为「仅搜索引擎摘要」。
# 安装：uv tool install yt-dlp（brew 版依赖 deno、需要完整 Xcode，本机验证装不上）
YTDLP_PATH=yt-dlp

# --- 图构建层 ---

# OpenAI 协议 LLM（可选）。走 /chat/completions，所以任何兼容端点都能接：
# DeepSeek（默认）、OpenAI、通义、本地 vLLM 都只是换下面两行。
# 填了则用 LLM 做语义级实体关系抽取与综述，留空则走本地启发式路径
# （分词 + TF-IDF + 共现 + Louvain），功能不受影响。
# 注意：密钥只写进 .env.local（已被 .gitignore 覆盖），别提交。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# 输出上限与超时。推理模型（如 deepseek-flash）的思维链与正文共享 max_tokens，
# 给小了会出现「正文为空、finish_reason=length」，所以默认给得比较宽。
LLM_MAX_TOKENS=32768
LLM_TIMEOUT_MS=300000

# --- 抓取层 ---

# 抓取/下载走的代理。置空则全部直连。
# 注意 Node 的全局 fetch 不读 HTTP_PROXY/HTTPS_PROXY，必须在这里显式配置。
# 只对境外站点生效：国内站点（B站/知乎/小红书/百度…）自动直连 —— 从境外出口
# 过去要么超时要么被风控。判定逻辑见 src/core/fetch/agent.ts。
FETCH_PROXY_URL=http://127.0.0.1:6666

# 是否启用 Playwright 无头浏览器降级（需先 npx playwright install chromium）
ENABLE_PLAYWRIGHT=false

# 并发与超时
FETCH_TIMEOUT_MS=15000
FETCH_MAX_BYTES=5242880
DOWNLOAD_CONCURRENCY=3
