# 复制为 .env.local 后按需填写。全部可留空 —— 缺失时会自动降级，不会崩溃。

# --- 搜索层 ---

# SearXNG 实例地址（默认值；自建用 pnpm searxng:setup / searxng:up）
SEARXNG_URL=http://localhost:8888

# 商业搜索 API（可选）。填了则优先于 SearXNG，失败时自动降级回去。
# 申请：https://serper.dev
SERPER_API_KEY=

# yt-dlp 可执行文件路径（可选）。用于 YouTube 搜索与字幕抓取。
# 未安装时 YouTube 会退化为「仅搜索引擎摘要」。
# 安装：uv tool install yt-dlp（brew 版依赖 deno、需要完整 Xcode，本机验证装不上）
YTDLP_PATH=yt-dlp

# --- 图构建层 ---

# OpenAI 协议 LLM（可选）。走 /chat/completions，所以任何兼容端点都能接：
# DeepSeek（默认）、OpenAI、通义、本地 vLLM 都只是换下面两行。
# 填了则用 LLM 做语义级实体关系抽取与综述，留空则走本地启发式路径
# （分词 + TF-IDF + 共现 + Louvain），功能不受影响。
# 注意：密钥只写进 .env.local（已被 .gitignore 覆盖），别提交。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# 输出上限与超时。推理模型（如 deepseek-flash）的思维链与正文共享 max_tokens，
# 给小了会出现「正文为空、finish_reason=length」，所以默认给得比较宽。
LLM_MAX_TOKENS=32768
LLM_TIMEOUT_MS=300000

# --- 抓取层 ---

# 抓取/下载走的代理。置空则全部直连。
# 注意 Node 的全局 fetch 不读 HTTP_PROXY/HTTPS_PROXY，必须在这里显式配置。
# 只对境外站点生效：国内站点（B站/知乎/小红书/百度…）自动直连 —— 从境外出口
# 过去要么超时要么被风控。判定逻辑见 src/core/fetch/agent.ts。
FETCH_PROXY_URL=http://127.0.0.1:6666

# 无头浏览器降级。三态：
#   off        不用浏览器（抓取快，JS 空壳站点退化为搜索摘要）
#   on-demand  只在判定为 JS 空壳页时才用【默认】
#   always     每篇都先用浏览器渲染（最准也最慢，且更容易被目标站判为爬虫）
# playwright 已经是 devDependency（知乎扫码登录要靠它开真实浏览器窗口），
# 只差浏览器二进制：npx playwright install chromium（约 150 MB，不入库）。
# 没装二进制时 on-demand/always 都等于关闭，/api/health 会明确区分
# 「已关闭」和「已启用但未安装」。
PLAYWRIGHT_MODE=on-demand

# 一轮抓取最多用几次无头浏览器。超额的那几篇不静默丢弃 —— 走降级路径并把
# 原因写进 doc.error。没有这道闸，一批 SPA 会串行跑满整个 maxDuration。
PLAYWRIGHT_MAX_PAGES_PER_RUN=8

# 旧变量，仍然认：ENABLE_PLAYWRIGHT=true 等价于 PLAYWRIGHT_MODE=on-demand
# ENABLE_PLAYWRIGHT=false

# 并发与超时
FETCH_TIMEOUT_MS=15000
FETCH_MAX_BYTES=5242880
DOWNLOAD_CONCURRENCY=3

# ── 搜索条数 ──
#
# 每站点抓取多少条结果。实测：这个数**不增加任何网络耗时**（它只是
# SearXNG 响应回来之后的截断），上游请求完全一样。上限由上游引擎决定，
# 常见查询大约能拿到 20 条，冷门查询可能只有 10 条。
# 注意：提条数只是让结果更全，**不会**让结果更准 —— 跑题的那些由
# 相关性判定（自动跑）标记，不靠条数解决。
SEARCH_PER_SITE_LIMIT=20

# 链上某条 provider 拿到这么多条就不再往下游走。**别调高**：
# 它是「还要不要再打一次付费 provider」的开关，调高等于每次都多花钱。
SEARCH_ENOUGH_RESULTS=4

# 视频站与话题源各自的条数（话题源是官方 API/RSS，有各自的速率限制，
# 所以不和上面的每站点上限共用一个数）
SEARCH_YOUTUBE_LIMIT=20
SEARCH_BILIBILI_LIMIT=20
SEARCH_HN_LIMIT=15
SEARCH_GITHUB_LIMIT=10
SEARCH_ARXIV_LIMIT=10
SEARCH_RSS_LIMIT=20
