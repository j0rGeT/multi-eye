# SearXNG 配置模板 —— 由 scripts/searxng-setup.sh 复制成 settings.yml 并填入密钥。
#
# 为什么不直接提交 settings.yml：里面有 server.secret_key。这个仓库是公开的，
# 而密钥一旦进了 git 历史就洗不掉了 —— 即使以后删掉文件，旧提交里还在。
# 所以仓库里只放带占位符的模板，真实密钥在本机生成、留在本机。
#
# scripts/searxng.sh 通过 SEARXNG_SETTINGS_PATH 指向 settings.yml。

# 三个必须的改动，缺一个搜索层就用不了：
#   1. search.formats 必须含 json  —— 默认只有 html，请求 format=json 会 403。
#      注意：这个没有环境变量可以覆盖，只能改文件。
#   2. server.limiter: false      —— 否则本机高频扇出查询会被实例自身的限流器拦掉。
#   3. 引擎白名单                  —— 见下。

server:
  # 用于签名 session/cookie。setup 脚本会用 `openssl rand -hex 32` 生成后替换。
  secret_key: "__SEARXNG_SECRET_KEY__"
  limiter: false
  public_instance: false
  image_proxy: true

search:
  safe_search: 0
  autocomplete: ""
  # 必须是具体 locale，不能是默认的 all：bing 引擎把 locale 翻成 mkt 市场参数，
  # 而 all → "clear" → 不发 mkt → bing 只返回 JS 空壳页（0 条结果且不报错）。
  default_lang: "zh-CN"
  formats:
    - html
    - json

# ─────────────────────────── 引擎白名单 ───────────────────────────
#
# 本机实测（2026-10，国内网络 + VPN 代理）只有这四个可用：
#   ✅ bing          —— 默认 disabled，需显式打开
#   ✅ duckduckgo
#   ✅ startpage     —— 返回的就是 Google 的结果集，用来补 Google 的缺口
#   ✅ mojeek        —— 独立索引，补充覆盖面
#   ❌ google        —— 对 SearXNG 的抓取返回 access denied
#   ❌ baidu         —— 反爬，命中 CAPTCHA 后被挂起 3600s
#   ❌ brave         —— too many requests
#
# 两层机制，缺一不可：
#   keep_only 负责「剔除」——不在这份名单里的引擎全部拿掉。默认配置有 350+
#     条引擎，全开着会让每次搜索都为那些不可达的引擎等满超时。
#   engines:  负责「启用」——keep_only 只剔除、不会启用默认就 disabled 的引擎,
#     所以 bing 必须在下面单独声明。
#
# 每一条都带 engine: 字段（引擎模块名）。只写 name 时 SearXNG 无法定位模块。
#
# inactive: false 是关键。上游默认给 startpage 与 mojeek 打了 inactive: true
# （认为它们已失效），而 searx/engines/__init__.py 会直接跳过 inactive 的引擎。
# 这个标记 keep_only 和 disabled 都覆盖不了，只能在这里显式重置 ——
# 否则表现为「配置里写了、也不报错、但引擎就是不出现」。
use_default_settings:
  engines:
    keep_only:
      - bing
      - duckduckgo
      - startpage
      - mojeek

engines:
  - name: bing
    engine: bing
    disabled: false

  - name: duckduckgo
    engine: duckduckgo
    disabled: false

  - name: startpage
    engine: startpage
    disabled: false
    inactive: false

  - name: mojeek
    engine: mojeek
    disabled: false
    inactive: false
