{
  "name": "muti-eye",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "example": "node examples/e2e.mjs",
    "example:graph": "node examples/show.mjs",
    "example:docs": "node examples/show.mjs --docs",
    "example:report": "node examples/show.mjs --report",
    "example:image": "node examples/graph-image.mjs",
    "ytdlp:fetch": "bash scripts/ytdlp-fetch.sh",
    "searxng:setup": "bash scripts/searxng-setup.sh",
    "searxng:up": "bash scripts/searxng.sh start",
    "searxng:down": "bash scripts/searxng.sh stop",
    "searxng:status": "bash scripts/searxng.sh status",
    "searxng:logs": "bash scripts/searxng.sh logs",
    "searxng:docker": "docker compose up -d"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "cheerio": "^1.2.0",
    "cytoscape": "^3.34.3",
    "cytoscape-fcose": "^2.2.0",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "jieba-wasm": "^2.4.0",
    "jsdom": "^30.1.2",
    "nanoid": "^6.0.2",
    "next": "^16.4.0",
    "p-limit": "^7.3.3",
    "p-retry": "^8.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "segmentit": "^2.0.3",
    "turndown": "^7.2.4",
    "undici": "^8.11.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cytoscape": "^3.31.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "typescript": "^7.0.2"
  }
}
